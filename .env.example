# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# Database (Prisma)
# ============================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/my_nest_db?schema=public"

# ============================================
# JWT Authentication & Tokens
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-production
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_SECRET_KEY=zevon-admin-secret-2026

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ============================================
# Throttle / Rate Limiting (optional)
# ============================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ============================================
# Stripe Payment Gateway
# ============================================
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=bdt
STRIPE_SUCCESS_URL=http://localhost:3000/order/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/order/cancel

# ============================================
# SMTP Mail Delivery (Order Confirmation & Receipts)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false
EMAIL_FROM="ZEVON Store <no-reply@zevon.com>"

